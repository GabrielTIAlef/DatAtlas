# Gemini automático ao enviar perguntas. A chave permanece no servidor.
GEMINI_ENABLED=true
# Preencha uma opção: chave em variável OU arquivo local que já contém a chave.
GEMINI_API_KEY=
GEMINI_KEY_FILE=
GEMINI_MODEL=gemini-3.1-flash-lite
# Limite local persistente; não amplia cotas do Google nem ativa faturamento.
GEMINI_DAILY_LIMIT=30
# Modo local. Na Oracle, o instalador usa /etc/datatlas/app.env protegido.
DATATLAS_PUBLIC_MODE=false
# Hosts públicos exigem modo pessoal ativo, usuário e hash configurados.
DATATLAS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATATLAS_ALLOWED_ORIGINS=http://localhost:8012,http://127.0.0.1:8012,http://testserver
DATATLAS_AUTH_USER=
DATATLAS_AUTH_SHA256=
# O modo session deve ser ativado explicitamente com segredo aleatório protegido.
DATATLAS_ACCESS_MODE=personal
DATATLAS_SESSION_KEY=
DATATLAS_DATASET_MEMORY_BYTES=25165824
DATATLAS_STORE_MEMORY_BYTES=50331648
